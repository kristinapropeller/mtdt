    <environments>Default</environments>
    <formulas>
        <name>BlankVacationsFormula</name>
        <dataType>String</dataType>
        <expression>&quot;*_No bookings for today_*&quot; + BR() + &quot;&gt; Everyone is at work.&quot;</expression>
    </formulas>
    <formulas>
        <name>BookedVacationFormula</name>
        <dataType>String</dataType>
        <expression>BR() + &quot;&gt; &quot; + {!For_Each_Vacation.Contact_Name__c} + &quot; has booked &lt;https://propellerplan.lightning.force.com/&quot; + {!For_Each_Vacation.Id} + &apos;|*_&apos; + TEXT({!For_Each_Vacation.Vacation_Type__c}) + &apos;_*&gt; &apos; + IF({!For_Each_Vacation.Vacation_End_Date__c} = {!For_Each_Vacation.Vacation_Start_Date__c}, &apos;today&apos;, &apos;up to and including &apos; + CASE(WEEKDAY({!For_Each_Vacation.Vacation_End_Date__c}),  1, &quot;Sunday&quot;, 2, &quot;Monday&quot;, 3, &quot;Tuesday&quot;, 4, &quot;Wednesday&quot;, 5, &quot;Thursday&quot;, 6, &quot;Friday&quot;, &quot;Saturday&quot;) + &apos;, &apos; + TEXT({!For_Each_Vacation.Vacation_End_Date__c}))</expression>
    </formulas>
    <formulas>
        <name>TodayIsWeekday</name>
        <dataType>Boolean</dataType>
        <expression>AND(WEEKDAY(TODAY()) &lt;&gt; 1, WEEKDAY(TODAY()) &lt;&gt; 7)</expression>
    </formulas>
    <interviewLabel>Daily Vacations Status {!$Flow.CurrentDateTime}</interviewLabel>
