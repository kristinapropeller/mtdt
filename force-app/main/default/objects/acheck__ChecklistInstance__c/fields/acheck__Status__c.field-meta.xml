<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>acheck__Status__c</fullName>
    <deprecated>false</deprecated>
    <description>Based on TaskCount, ClosedCount, ActiveCount</description>
    <externalId>false</externalId>
    <formula>IF (acheck__ClosedCount__c ==  acheck__TaskCount__c, &apos;Closed&apos;,
 IF(acheck__ActiveCount__c &gt; 0, &apos;Active&apos;, &apos;Waiting&apos;)
)</formula>
    <inlineHelpText>Closed | Active | Waiting</inlineHelpText>
    <label>Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
