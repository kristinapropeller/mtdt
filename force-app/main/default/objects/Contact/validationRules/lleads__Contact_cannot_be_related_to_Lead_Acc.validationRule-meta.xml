<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>lleads__Contact_cannot_be_related_to_Lead_Acc</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK( AccountId )),
				NOT(ISBLANK( lleads__Lead__c ))
)</errorConditionFormula>
    <errorMessage>Contact cannot be related to the Lead and Account at the same time.</errorMessage>
</ValidationRule>
