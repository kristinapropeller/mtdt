<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TVA_CO__Start_Date_greater_than_today</fullName>
    <active>false</active>
    <errorConditionFormula>AND((ISPICKVAL(TVA_CO__Frequency__c, &quot;Daily&quot;) || ISPICKVAL(TVA_CO__Frequency__c, &quot;Weekly&quot;)),TVA_CO__StartDate__c 
 &lt;= today())</errorConditionFormula>
    <errorDisplayField>TVA_CO__StartDate__c</errorDisplayField>
    <errorMessage>Start Date must be greater than today</errorMessage>
</ValidationRule>
