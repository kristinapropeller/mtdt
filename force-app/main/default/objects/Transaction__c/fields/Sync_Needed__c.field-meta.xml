<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sync_Needed__c</fullName>
    <formula>OR(
   ISNULL(Last_Synced__c),
    LastModifiedDate &gt; Last_Synced__c
)</formula>
